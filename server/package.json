    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "vitest": "^5.0.3"
