# Copy to server/.env and adjust. Read by the server via `node --env-file-if-exists=.env`.

NODE_ENV=development

# Express API port (Vite proxies /api here)
PORT=4000

# Origin the browser uses; non-GET requests must send this Origin (CSRF check)
APP_ORIGIN=http://localhost:5173

# SQLite database file (created on first run)
DB_PATH=./data/app.db

# Session lifetime in days (sliding)
SESSION_TTL_DAYS=30

# Set to true only when serving over HTTPS
COOKIE_SECURE=false
